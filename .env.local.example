# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, NEVER exposed to the client/browser.
# Used only in server actions / route handlers for privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app, used for building public case-status links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
